{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookworm-cloud",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookworm-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "workflows": [
    {
      "name": "bookworm-long-task",
      "binding": "LONG_TASK_WORKFLOW",
      "class_name": "BookwormLongTaskWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
